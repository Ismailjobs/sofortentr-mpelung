# Kopieren nach `.env.local` (wird nicht committet). Contact-API lädt diese Dateien aus dem Projektroot.
# Brevo → https://app.brevo.com/settings/keys/api  („API Keys“ / Transactional)

BREVO_API_KEY=

# IndexNow (Bing/Yandex) — optional
# Schlüssel: UUID ohne Bindestriche, z. B. via `openssl rand -hex 16`
INDEXNOW_KEY=
# Geheimer Bearer-Token für POST /api/indexnow
INDEXNOW_SECRET=
